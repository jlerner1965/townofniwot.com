  @media (max-width:520px){.n-key{grid-template-columns:minmax(0,1fr)}}
---
{%- set rr = annualBuild.byId['rock-rails'] %}
<section class="n-bg-white" aria-labelledby="title-h">
<div class="n-wrap" style="padding-top:clamp(28px,4vw,60px);padding-bottom:clamp(20px,2.5vw,36px)">
<div class="n-g2-wide" style="align-items:end">
<div>
<div class="n-label">Free concerts, Whistle Stop Park</div>
<h1 class="n-display" id="title-h" style="margin-top:14px;font-size:clamp(1.875rem,1.4rem + 1.9vw,2.875rem);line-height:1.05;max-width:24ch;color:var(--n-evergreen)">Rock &amp; Rails, Niwot</h1>
</div>
<div>
<p class="n-lead" style="margin:0;max-width:50ch">The free Thursday-evening concert series on the lawn beside the caboose, and the largest thing Niwot does. Produced by the Niwot Cultural Arts Association with the Niwot Business Association.</p>
<nav aria-label="On this page">
<ul class="n-toc">
<li><a class="n-link" href="#season">This season</a></li>
<li><a class="n-link" href="#getting-there">Getting there &amp; parking</a></li>
<li><a class="n-link" href="#food">Food and drink</a></li>
<li><a class="n-link" href="#before">Before you go</a></li>
</ul>
</nav>
</div>
</div>
<dl class="n-key">
<div>
<dt>Where</dt>
<dd>Whistle Stop Park, Old Town</dd>
</div>
<div>
<dt>When</dt>
<dd>Thursday evenings, June to August</dd>
</div>
<div>
<dt>Admission</dt>
<dd>Free</dd>
</div>
<div>
<dt>Run by</dt>
<dd>Niwot Cultural Arts Association</dd>
</div>
</dl>
</div>
