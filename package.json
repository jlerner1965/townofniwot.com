{
  "name": "townofniwot.com",
  "version": "2.0.0",
  "private": true,
  "description": "Niwot, Colorado — a static site with a WebGL hero, GSAP scroll choreography and original illustrations.",
  "type": "module",
  "scripts": {
    "start": "http-server -p 4173 -c-1 .",
    "vendor": "cp node_modules/gsap/dist/gsap.min.js node_modules/gsap/dist/ScrollTrigger.min.js vendor/",
    "photos": "node scripts/photos.mjs",
    "audit": "lighthouse http://127.0.0.1:4173/ --quiet --chrome-flags=\"--headless=new\" --output=html --output-path=./lighthouse.html"
  },
  "dependencies": {
    "gsap": "^3.15.0"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.2.5",
    "@fontsource/atkinson-hyperlegible": "^5.2.5",
    "http-server": "^14.1.1",
    "lighthouse": "^12.0.0",
    "sharp": "^0.34.0"
  }
}
